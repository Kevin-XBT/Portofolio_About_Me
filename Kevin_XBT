<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kevin Fx · See Clearly. Execute Sharply.</title>
<meta name="description" content="Kevin Fx (@Kevin_XBT): public market research, timestamped calls, and a free quant algo. Quant, order flow and macro.">
<link rel="icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;600;700&family=Manrope:wght@300;400;500;600;700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#050506; --bg2:#0b0b0d; --card:rgba(14,14,17,.82); --line:rgba(255,255,255,.08); --line2:rgba(255,255,255,.15);
  --ink:#ececed; --mute:#8e8e94; --dim:#5b5b61; --violet:#9d6bff; --violet2:#c7a8ff; --blue:#2f6bff; --red:#ff2d55;
  --display:"Unbounded","Segoe UI",system-ui,sans-serif; --body:"Manrope","Segoe UI",system-ui,-apple-system,sans-serif;
  --ease:cubic-bezier(.2,.8,.2,1); --pad:clamp(18px,5vw,64px);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;background:var(--bg)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
::selection{background:rgba(157,107,255,.35);color:#fff}

/* ---------- atmosphere ---------- */
#bg{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
.grain{position:fixed;inset:-50%;z-index:1;pointer-events:none;opacity:.06;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  animation:grain 1.2s steps(6) infinite}
@keyframes grain{0%,100%{transform:translate(0,0)}20%{transform:translate(-3%,2%)}40%{transform:translate(2%,-3%)}60%{transform:translate(-2%,-1%)}80%{transform:translate(3%,3%)}}
.vignette{position:fixed;inset:0;z-index:2;pointer-events:none;
  background:radial-gradient(120% 90% at 50% 50%,transparent 55%,rgba(0,0,0,.78) 100%),
   radial-gradient(38% 60% at -6% 50%,rgba(47,107,255,.17),transparent 70%),
   radial-gradient(38% 60% at 106% 50%,rgba(255,45,85,.14),transparent 70%)}
.edgeblur{position:fixed;inset:0;z-index:2;pointer-events:none;backdrop-filter:blur(2.5px);-webkit-backdrop-filter:blur(2.5px);
  -webkit-mask-image:radial-gradient(85% 80% at 50% 50%,transparent 63%,#000 100%);mask-image:radial-gradient(85% 80% at 50% 50%,transparent 63%,#000 100%)}
#progress{position:fixed;left:0;top:0;height:2px;width:0;z-index:60;background:linear-gradient(90deg,var(--blue),#fff 45%,var(--violet) 70%,var(--red));box-shadow:0 0 10px rgba(157,107,255,.6)}
main,header,footer{position:relative;z-index:3}
body.fs main{z-index:70}
body.fs #record{z-index:90}
.logo{}

/* ---------- rotating glow border: two bright arcs and two dark arcs spinning around the edge.
   A pre-rendered square spins (GPU transform) inside ring masks: one crisp ring plus two faint outer halos. ---------- */
.gb{position:relative;border-color:transparent!important}
.gl,.gl2,.gl3{position:absolute;border-radius:inherit;pointer-events:none;overflow:hidden;z-index:4;
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;
  mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0)}
.gl{inset:-1px;padding:1.5px}
.gl2{inset:-3px;padding:2px;opacity:.45}
.gl3{inset:-6px;padding:3px;opacity:.16}
.gl i,.gl2 i,.gl3 i{position:absolute;left:50%;top:50%;width:var(--d,240px);height:var(--d,240px);margin:calc(var(--d,240px) / -2) 0 0 calc(var(--d,240px) / -2);
  animation:gspin 5.5s linear infinite;will-change:transform}
.gl i{background:conic-gradient(rgba(255,255,255,.12) 0deg,rgba(255,255,255,.12) 10deg,#fff 45deg,rgba(255,255,255,.12) 80deg,rgba(0,0,0,.9) 135deg,rgba(255,255,255,.12) 190deg,#fff 225deg,rgba(255,255,255,.12) 260deg,rgba(0,0,0,.9) 315deg,rgba(255,255,255,.12) 360deg)}
.gl2 i,.gl3 i{background:conic-gradient(transparent 0deg,transparent 18deg,#fff 45deg,transparent 72deg,transparent 198deg,#fff 225deg,transparent 252deg,transparent 360deg)}
.gb.soft .gl i,.gb.soft .gl2 i,.gb.soft .gl3 i{animation-duration:9s}
.gb.soft .gl2{opacity:.32}.gb.soft .gl3{opacity:.1}
.gb:not(.vis) i,.gb.busy i{animation-play-state:paused}
@keyframes gspin{to{transform:rotate(360deg)}}

/* ---------- loader ---------- */
#loader{position:fixed;inset:0;z-index:100;background:#030304;display:grid;place-items:center;transition:opacity .8s var(--ease),visibility .8s}
#loader.done{opacity:0;visibility:hidden}
#loader img{width:120px;animation:lIn 1.3s var(--ease) both}
@keyframes lIn{0%{opacity:0;filter:blur(14px);transform:scale(.85)}60%{opacity:1}100%{opacity:1;filter:blur(0);transform:none}}
#loader p{margin:16px 0 0;text-align:center;font:500 10px var(--body);letter-spacing:.5em;color:var(--mute);opacity:0;animation:fade .6s .7s forwards}
@keyframes fade{to{opacity:1}}

/* ---------- cursor (desktop pointer only) ---------- */
#cur{position:fixed;inset:0;z-index:97;pointer-events:none;display:none}
#cur .cdot{position:absolute;width:5px;height:5px;margin:-2.5px 0 0 -2.5px;border-radius:50%;background:#fff;box-shadow:0 0 8px #fff,0 0 18px rgba(157,107,255,.8)}
#cur .cfr{position:absolute;left:0;top:0;transform-origin:center}
#cur .cfr i{position:absolute;width:9px;height:9px;border:1.5px solid #fff;filter:drop-shadow(0 0 4px rgba(255,255,255,.7))}
#cur .cfr i:nth-child(1){left:0;top:0;border-right:0;border-bottom:0}
#cur .cfr i:nth-child(2){right:0;top:0;border-left:0;border-bottom:0}
#cur .cfr i:nth-child(3){left:0;bottom:0;border-right:0;border-top:0}
#cur .cfr i:nth-child(4){right:0;bottom:0;border-left:0;border-top:0}
#cur .cglow{position:absolute;width:520px;height:520px;margin:-260px 0 0 -260px;border-radius:50%;background:radial-gradient(circle,rgba(157,107,255,.10),rgba(47,107,255,.04) 40%,transparent 70%);mix-blend-mode:screen}
#cur .clab{position:absolute;font:600 9px var(--body);letter-spacing:.24em;color:#fff;opacity:0;transition:opacity .2s;white-space:nowrap}
#cur.hot .clab{opacity:.8}
@media (hover:hover) and (pointer:fine){#cur{display:block}body.cur,body.cur a,body.cur button{cursor:none}}

/* ---------- nav ---------- */
.nav{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;align-items:center;justify-content:space-between;
  padding:calc(12px + env(safe-area-inset-top,0px)) var(--pad) 12px;transition:background .4s,border-color .4s;border-bottom:1px solid transparent}
.nav.solid{background:rgba(5,5,6,.68);backdrop-filter:blur(16px) saturate(140%);-webkit-backdrop-filter:blur(16px) saturate(140%);border-bottom-color:var(--line)}
.brand{display:flex;align-items:center;gap:10px;font:600 12px var(--display);letter-spacing:.14em}
.brand img{width:36px;height:36px}
.links{display:flex;gap:26px;font-size:12.5px;color:var(--mute)}
.links a{position:relative;transition:color .25s}
.links a:hover,.links a.on{color:#fff}
.links a::after{content:"";position:absolute;left:0;right:0;bottom:-6px;height:1px;background:#fff;transform:scaleX(0);transition:transform .35s var(--ease)}
.links a.on::after,.links a:hover::after{transform:scaleX(1)}
.btn{display:inline-flex;align-items:center;gap:9px;padding:11px 19px;border-radius:999px;font:600 12.5px var(--body);letter-spacing:.02em;border:1px solid var(--line2);background:#0d0d10;color:#fff;transition:background .3s,transform .3s var(--ease),box-shadow .3s;cursor:pointer}
.btn:hover{background:#17171b;box-shadow:0 0 30px rgba(255,255,255,.08)}
.btn.solid{background:#f1f1f2;color:#08080a;border-color:#f1f1f2}
.btn.solid:hover{background:#fff;box-shadow:0 0 34px rgba(255,255,255,.25)}
.btn svg{width:14px;height:14px}
.btn:focus-visible,.links a:focus-visible,.rcard:focus-visible{outline:2px solid var(--violet2);outline-offset:3px}
.navR{display:flex;gap:10px;align-items:center}
.menuBtn{display:none;width:42px;height:42px;border-radius:50%;border:1px solid var(--line2);background:#0d0d10;cursor:pointer;align-items:center;justify-content:center}
.menuBtn span,.menuBtn span::before{display:block;width:16px;height:1.5px;background:#fff;position:relative;transition:transform .3s}
.menuBtn span::before{content:"";position:absolute;top:5px}
.menuBtn[aria-expanded="true"] span{transform:translateY(2.5px) rotate(45deg)}
.menuBtn[aria-expanded="true"] span::before{transform:translateY(-5px) rotate(-90deg)}
#mmenu{position:fixed;inset:0;z-index:45;background:rgba(5,5,6,.95);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);display:flex;flex-direction:column;justify-content:center;gap:4px;padding:0 var(--pad);opacity:0;visibility:hidden;transition:opacity .35s,visibility .35s}
#mmenu.on{opacity:1;visibility:visible}
#mmenu a{font:600 clamp(22px,6.5vw,34px)/1.3 var(--display);letter-spacing:-.02em}
#mmenu a small{font:500 11px var(--body);color:var(--dim);margin-right:12px;letter-spacing:.2em}

/* ---------- dots ---------- */
.dots{position:fixed;right:20px;top:50%;transform:translateY(-50%);z-index:40;display:flex;flex-direction:column;gap:13px}
.dots a{display:flex;align-items:center;justify-content:flex-end;gap:10px;font-size:10.5px;color:transparent;transition:color .3s}
.dots a i{width:5px;height:5px;border-radius:50%;background:var(--dim);transition:all .3s}
.dots a:hover{color:var(--mute)}
.dots a.on i{background:#fff;box-shadow:0 0 10px #fff;transform:scale(1.5)}

/* ---------- layout ---------- */
section{position:relative;isolation:isolate;padding:clamp(80px,12vh,120px) var(--pad)}
.inner{max-width:1120px;margin:0 auto}
.sbg{position:absolute;inset:0;z-index:-1;background-position:center;background-size:cover;opacity:.15;filter:grayscale(1) contrast(1.15) blur(1.5px);
  -webkit-mask-image:linear-gradient(180deg,transparent,#000 22%,#000 78%,transparent);mask-image:linear-gradient(180deg,transparent,#000 22%,#000 78%,transparent)}
.kicker{display:flex;align-items:center;gap:12px;font:600 10.5px var(--body);letter-spacing:.3em;text-transform:uppercase;color:var(--mute);margin-bottom:18px}
.kicker b{color:#fff;font-weight:600}
.kicker::before{content:"";width:28px;height:1px;background:linear-gradient(90deg,#fff,transparent)}
h1,h2,h3{font-family:var(--display);font-weight:600;letter-spacing:-.02em;margin:0;line-height:1.08}
h2{font-size:clamp(26px,3.4vw,44px)}
h3{font-size:15px;letter-spacing:0;line-height:1.3}
.ca{text-shadow:-1px 0 rgba(255,45,85,.45),1px 0 rgba(47,107,255,.45)}
.lead{font-size:clamp(15px,1.3vw,17px);color:#bdbdc2;max-width:560px;font-weight:400;margin:14px 0 0}
.mute{color:var(--mute)}
.small{font-size:13px;color:var(--mute)}
.row{display:flex;flex-wrap:wrap;gap:10px;align-items:center}

/* reveal */
.rv{opacity:0;transform:translateY(26px);filter:blur(6px);transition:opacity .9s var(--ease),transform .9s var(--ease),filter .9s var(--ease)}
.rv.in{opacity:1;transform:none;filter:none}
.rv.up:not(.in){transform:translateY(-26px)}
.split.up:not(.in) .w{transform:translateY(-.5em)}
.rv.settled{transition:transform .25s var(--ease),background .3s}
.split .w{display:inline-block;opacity:0;transform:translateY(.5em);filter:blur(5px);transition:all .8s var(--ease)}
.split.in .w{opacity:1;transform:none;filter:none}

/* ---------- hero ---------- */
.hero{min-height:100svh;display:flex;flex-direction:column;justify-content:center;padding-top:110px;padding-bottom:40px;overflow:hidden}
.heroImg{position:absolute;inset:0;z-index:-1;overflow:hidden}
.heroImg img{width:100%;height:100%;object-fit:cover;object-position:center 30%;filter:grayscale(.95) contrast(1.15) brightness(.5);transform:scale(1.08);will-change:transform}
.heroImg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(5,5,6,.5),rgba(5,5,6,.25) 40%,rgba(5,5,6,.9) 85%,var(--bg)),radial-gradient(70% 60% at 50% 45%,transparent,rgba(5,5,6,.55))}
.heroLogo{width:clamp(70px,8vw,104px);margin-bottom:6px;animation:hb 6s ease-in-out infinite}
@keyframes hb{0%,100%{filter:brightness(1)}50%{filter:brightness(1.35)}}
.hero h1{font-size:clamp(40px,7.6vw,104px);line-height:.92;letter-spacing:-.04em;font-weight:700}
.hero h1 .thin{font-weight:500;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.75)}
.hero h1 .thin .w{text-shadow:none}
.handle{margin-top:8px;font-size:12px;color:var(--mute);letter-spacing:.06em}
.htag{margin-top:16px;font:600 10.5px var(--body);letter-spacing:.42em;color:#fff}
.hero .ctas{margin-top:26px}
.stats{margin-top:48px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;max-width:820px}
.stat{padding:16px 18px;border-radius:16px;background:var(--card);border:1px solid var(--line)}
.stat .n{font:600 clamp(20px,2.2vw,28px) var(--display);letter-spacing:-.02em}
.stat .l{font-size:11.5px;color:var(--mute);margin-top:2px}

/* ---------- about ---------- */
.about{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(26px,5vw,70px);align-items:center}
.portrait{border-radius:20px;max-width:340px;justify-self:end;border:1px solid var(--line2)}
.portrait img{filter:grayscale(.3) contrast(1.05);border-radius:19px}
.chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:22px}
.chip{padding:6px 12px;border:1px solid var(--line2);border-radius:999px;font-size:11.5px;color:#cfcfd4;background:rgba(255,255,255,.02);transition:all .3s}
.chip:hover{border-color:#fff;color:#fff}

/* ---------- standard ---------- */
.rules{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:34px}
.rule{padding:18px;border-radius:16px;background:var(--card);border:1px solid var(--line)}
.rule .k{font-size:10px;letter-spacing:.24em;color:var(--dim)}
.rule p{margin:6px 0 0;font-size:14px;color:#e2e2e5;font-weight:600}
.flow{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:22px;font-size:11.5px;letter-spacing:.14em;color:var(--mute)}
.flow span{padding:6px 11px;border:1px solid var(--line);border-radius:999px}
.flow i{font-style:normal;color:var(--dim)}

/* ---------- research ---------- */
.rgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:34px}
.rcard{border-radius:18px;background:var(--card);border:1px solid var(--line);cursor:pointer;transition:transform .35s var(--ease)}
.rcard .ph{height:150px;overflow:hidden;position:relative;border-radius:17px 17px 0 0}
.rcard .ph img{width:100%;height:100%;object-fit:cover;object-position:left center;filter:grayscale(.25) brightness(.85);transition:transform 1s var(--ease),filter .5s}
.rcard:hover .ph img,.rcard.open .ph img{transform:scale(1.06);filter:none}
.rcard .ph::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(14,14,17,.95))}
.rcard .tx{padding:14px 18px 18px}
.rcard p{margin:6px 0 0;font-size:13px;color:var(--mute)}
.rcard .hd{display:flex;justify-content:space-between;align-items:center;gap:10px}
.rcard .pl{width:22px;height:22px;flex:none;border-radius:50%;border:1px solid var(--line2);display:grid;place-items:center;font-size:14px;line-height:1;transition:transform .4s var(--ease),background .3s,color .3s}
.rcard.open .pl{transform:rotate(45deg);background:#fff;color:#000}
.rcard .more{display:grid;grid-template-rows:0fr;transition:grid-template-rows .5s var(--ease)}
.rcard.open .more{grid-template-rows:1fr}
.rcard .more>div{overflow:hidden}
.rcard .more p{color:#c9c9ce;font-size:13px;padding-top:10px;border-top:1px solid var(--line);margin:12px 0 0}
.rcard .view{display:inline-block;margin-top:10px;font-size:11.5px;color:#fff;border-bottom:1px solid rgba(255,255,255,.35);cursor:zoom-in}

/* ---------- track record ---------- */
.hl{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:30px 0 18px}
.hcard{padding:18px 20px;border-radius:16px;background:var(--card);border:1px solid var(--line)}
.hcard .d{font-size:10px;letter-spacing:.22em;color:var(--mute)}
.hcard h3{margin:8px 0 6px}
.hcard p{margin:0;font-size:13px;color:var(--mute)}
.pill{display:inline-block;margin-top:10px;padding:3px 9px;border-radius:999px;font-size:10.5px;font-weight:600;border:1px solid var(--line2)}
.pill.bear{border-color:rgba(199,168,255,.5);color:#e2d3ff;background:rgba(157,107,255,.12)}
.pill.bull{border-color:rgba(255,255,255,.4);background:rgba(255,255,255,.07)}
.lgd{display:flex;flex-wrap:wrap;gap:18px;align-items:center;margin-bottom:12px;font-size:12px;color:var(--mute)}
.lgd i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:7px;vertical-align:-1px}
.lgd .w i{background:#fff;box-shadow:0 0 8px #fff}.lgd .v i{background:var(--violet);box-shadow:0 0 8px var(--violet)}
.frameWrap{border-radius:20px;height:min(80vh,780px);min-height:500px}
.frameWrap.full{position:fixed;inset:0;z-index:95;height:100dvh;min-height:0;border-radius:0}
.frameWrap.full .gl,.frameWrap.full .gl2,.frameWrap.full .gl3{display:none}
#tr{position:relative;width:100%;height:100%;border-radius:inherit;overflow:hidden;isolation:isolate;
  background:radial-gradient(900px 600px at 12% -10%,rgba(120,60,255,.22),transparent 60%),radial-gradient(800px 600px at 105% 110%,rgba(184,77,255,.16),transparent 60%),#07050d;
  font-family:"Sora","Segoe UI",system-ui,sans-serif;color:#f4f1ff;line-height:normal;font-size:16px}
.lock{position:absolute;inset:0;z-index:30;display:grid;place-items:center;border-radius:inherit;background:radial-gradient(60% 60% at 50% 50%,rgba(5,5,6,.15),rgba(5,5,6,.5));cursor:pointer;transition:opacity .4s}
.lock.off{opacity:0;pointer-events:none}
.lock span{padding:12px 20px;border-radius:999px;border:1px solid rgba(255,255,255,.3);background:rgba(10,10,12,.75);font-weight:600;font-size:13px;box-shadow:0 0 40px rgba(157,107,255,.25)}
.frameBar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-top:12px;font-size:12px;color:var(--mute)}
.closeFull{position:fixed;top:calc(10px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);z-index:96;display:none}
.closeFull.on{display:inline-flex}

/* ---------- mistakes ---------- */
.mist{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:30px}
.mist div{padding:18px;border-radius:16px;background:var(--card);border:1px solid var(--line)}
.mist b{display:block;font:600 13.5px var(--display)}
.mist span{font-size:12.5px;color:var(--mute)}

/* ---------- exxe ---------- */
.banner{position:relative;border-radius:22px;overflow:hidden;border:1px solid var(--line2)}
.banner img{width:100%;height:clamp(180px,26vw,320px);object-fit:cover;filter:grayscale(.65) contrast(1.1) brightness(.7)}
.banner::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,5,6,.92),rgba(5,5,6,.5) 50%,transparent 80%)}
.banner .txt{position:absolute;left:clamp(18px,4vw,44px);top:50%;transform:translateY(-50%);z-index:2;max-width:480px}
.exRow{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,4vw,50px);align-items:center;margin-top:34px}
.sig{border-radius:18px;overflow:hidden;border:1px solid var(--line2);cursor:zoom-in;max-width:520px;justify-self:end}
.sig img{filter:saturate(.45);transition:filter .5s}
.sig:hover img{filter:none}
.stack{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:30px}
.tier{position:relative;padding:20px;border-radius:18px;background:var(--card);border:1px solid var(--line)}
.tier .lab{font-size:10px;letter-spacing:.24em;color:var(--mute)}
.tier h3{margin:8px 0 10px}
.tier ul{margin:0;padding:0;list-style:none}
.tier li{padding:6px 0;border-top:1px solid var(--line);font-size:12.5px;color:#cfcfd4}
.tier .badge{position:absolute;top:18px;right:18px;font:700 9.5px var(--display);letter-spacing:.16em;padding:4px 8px;border-radius:999px}
.tier .badge.free{background:#fff;color:#000;box-shadow:0 0 18px rgba(255,255,255,.4)}
.tier .badge.lockd{border:1px solid var(--line2);color:var(--dim)}
.note{margin-top:14px;padding:14px 18px;border:1px dashed var(--line2);border-radius:14px;font-size:12.5px;color:#b5b5ba}
.note b{color:#fff}

/* ---------- partnership ---------- */
.offer{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:30px}
.off{padding:18px;border-radius:16px;background:var(--card);border:1px solid var(--line)}
